def baxola(ismlar):
    baxolar = {}

    while ismlar:
        ism = ismlar.pop()
        baxo = input(f"{ism}ning bahosini kiriting: ")
        baxolar[ism] = int(baxo)

    return baxolar


talabalar = ["Ali", "Vali", "Hasan"] 

baxolar = baxola(talabalar)
print(baxolar)

