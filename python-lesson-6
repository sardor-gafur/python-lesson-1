def talaba_baholari():
    talabalar = []
    baxolar = {}

    son = int(input("Nechta talaba kiritasiz? "))

    for i in range(son):
        ism = input(f"{i+1}-talabaning ismini kiriting: ")
        talabalar.append(ism)

    print("\nEndi baholarni kiriting.\n")

    while talabalar:
        ism = talabalar.pop()
        baho = int(input(f"{ism}ning bahosini kiriting: "))
        baxolar[ism] = baho

    return baxolar


natija = talaba_baholari()

print("\nNatijalar:")
for ism, baho in natija.items():
    print(f"{ism} -> {baho}")


