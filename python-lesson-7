# random funksiyasi bu siz belgilagan malum bir sonlar oralidan siz uchun tasodifiy sonni yoki tasodifiy elementni chiqazadi.
# randint kopincha ishlatiladi aslida u rand= random  int- intijet

import random

# Kompyuter 1 dan 100 gacha son o'ylaydi
sirli_son = random.randint(1, 100)

urinishlar = 0

print("=== SON TOPISH O'YINI ===")
print("Men 1 dan 100 gacha son o'yladim.")
print("Uni topishga harakat qiling!")

while True:
    taxmin = int(input("Son kiriting: "))
    urinishlar += 1

    if taxmin < sirli_son:
        print("Juda kichik son kiritdingiz!")
    elif taxmin > sirli_son:
        print("Juda katta son kiritdingiz!")
    else:
        print("🎉 Tabriklayman!")
        print(f"Sirli son: {sirli_son}")
        print(f"Siz {urinishlar} ta urinishda topdingiz.")
        break


# shuffle() funksiyamzi mix qilib yani aralashtirib beruvchi funksiya quyidagi kodlar orqali tushinib olishingiz mumkin.
import random

savollar = [
    "1. Python kim tomonidan yaratilgan?",
    "2. List nima?",
    "3. Tuple nima?",
    "4. Dictionary nima?",
    "5. While sikli nima qiladi?",
    "6. For sikli nima qiladi?",
    "7. Function nima?",
    "8. Class nima?"
]

print("=== Aralashtirishdan oldin ===")
for savol in savollar:
    print(savol)

random.shuffle(savollar)

print("\n=== Aralashtirilgandan keyin ===")
for savol in savollar:
    print(savol)





